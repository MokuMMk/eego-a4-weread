# EEGO A4 papers3-weread ESP-IDF 默认配置
# 纯 ESP-IDF，无 Arduino 依赖

# 目标芯片
CONFIG_IDF_TARGET="esp32s3"

# Flash: 16MB DIO 80MHz
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 分区表：自定义 16MB
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# PSRAM: Octal 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 不让普通 malloc 自动使用 PSRAM（避免 WiFi/NVS 内部分配到 PSRAM 导致 flash 写崩溃）
# PSRAM 只通过 heap_caps_malloc(MALLOC_CAP_SPIRAM) 显式分配
# CONFIG_SPIRAM_USE_MALLOC is not set
# 不把 WiFi/LWIP 缓冲区放 PSRAM（会导致 WiFi 驱动内部崩溃）
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152

# FATFS: UTF-8 长名 + HEAP 模式
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_437=y
CONFIG_FATFS_MAX_LFN=255

# WiFi — 禁用 IRAM OP（与 PSRAM 冲突会导致 mgd_probe 崩溃）
# 禁用 WiFi NVS（ppTask 中 nvs_open 会触发 esp_partition_main_flash_region_safe 崩溃）
CONFIG_ESP32_WIFI_ENABLED=y
# TX 功率固定 20dBm（法规上限），不用 esp_wifi_set_max_tx_power() 运行时设置
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20
# CONFIG_ESP32_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP32_WIFI_IRAM_OPT is not set
# CONFIG_ESP32_WIFI_RX_IRAM_OPT is not set

# HTTPS / TLS
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# lwIP TCPIP 任务栈（sys_evt）：默认 3072 太小，DHCP 拿到 IP 时调用链深会溢出
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192

# 默认事件循环任务栈（esp_event）：配网回调里会做 SD/JSON 写入，
# 默认 2304+512 太小会栈溢出并踩坏相邻任务（表现为误报 sys_evt 溢出）
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# 主任务栈：登录续期/书架/正文全部 TLS 请求都跑在主任务，
# 3584 太小，TLS 握手+证书校验会栈溢出触发 Double Exception；
# 16KB 仍会被 initShelf 的 50KB 局部数组爆栈踩坏内存，故取 32KB 上限
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# 串口控制台
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# SPI master
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# I2C
CONFIG_I2C_ENABLE_DEBUG_LOG=n
